#!/usr/bin/env php
<?php

declare(strict_types=1);

use Aorinex\AorinexNew\Application;

$root = dirname(__DIR__);

$autoloadCandidates = [
    $root . '/vendor/autoload.php',
    $root . '/../../autoload.php', // composer global: vendor/aorinex/aorinex-new
];

$loaded = false;
foreach ($autoloadCandidates as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        $loaded = true;
        break;
    }
}

if (!$loaded) {
    spl_autoload_register(static function (string $class) use ($root): void {
        $prefix = 'Aorinex\\AorinexNew\\';
        if (!str_starts_with($class, $prefix)) {
            return;
        }
        $relative = str_replace('\\', '/', substr($class, strlen($prefix)));
        $file = $root . '/src/' . $relative . '.php';
        if (is_file($file)) {
            require $file;
        }
    });
}

$app = new Application();
exit($app->run($argv));
